---
import Base from '../layouts/Base.astro';
import Connection from '../components/Connection.astro';
import StudentNotebook from '../components/StudentNotebook.astro';
import { hero, onderzoek, ervaring, contact, dateline, documenten, cvBeschikbaar, cvBestand, briefBeschikbaar, briefBestand } from '../content/site.js';
---
<Base huidig="home">
  <div class="band hero-band">
  <section class="hero container" aria-labelledby="hero-kop">
    <div class="hero-copy">
      <h1 id="hero-kop"><span class="title-first">{hero.titel[0]}</span><em class="title-second">{hero.titel[1]}</em></h1>
      <p class="hero-intro">{hero.introductie}</p>
      <div class="hero-actions">
        <a class="primary-link" href="#ervaring">
          {hero.actie}
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v16m-6-6 6 6 6-6" /></svg>
        </a>
        <a class="text-link" href="/brief">Lees mijn motivatiebrief <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></a>
      </div>
      <p class="dateline">
        <span class="proc">{hero.procedure}</span>
        <span>{dateline.plaats}</span>
        <span>{dateline.datum}</span>
      </p>
    </div>
    <figure class="portrait">
      <div class="portrait-window"><img src="/images/stephanus-harsono.jpg" srcset="/images/stephanus-harsono.jpg 666w, /images/stephanus-harsono-1024.jpg 1024w" sizes="(max-width: 860px) 100vw, 40vw" alt="Portret van Stephanus Harsono" width="666" height="1000" fetchpriority="high" decoding="async" /></div>
      <figcaption><strong>{hero.naam}</strong><span>{hero.rol}</span></figcaption>
    </figure>
  </section>
  </div>

  <section class="experience container" id="ervaring" aria-labelledby="ervaring-kop">
    <div class="experience-layout">
      <div class="experience-guide">
        <div class="experience-head">
          <h2 id="ervaring-kop">{ervaring.titel}</h2>
          <p class="experience-lede"><span>{ervaring.intro[0]}</span><em>{ervaring.intro[1]}</em></p>
        </div>
        <Connection />
        <nav class="chapter-nav" aria-label="Praktijkvoorbeelden">
          {ervaring.onderdelen.map((item) => <a href={`#${item.id}`} data-chapter={item.id}>{item.label}<span class="chapter-marker" aria-hidden="true"></span></a>)}
        </nav>
      </div>
      <div class="experience-list">
        {ervaring.onderdelen.map((item) => (
          <article class="experience-row" id={item.id}>
            <div class="scene-anchor">
              <p class="scene-label">{item.label}</p>
              {item.anker && (
                <p class="scene-figure">{item.anker}<span>{item.ankerToelichting}</span></p>
              )}
            </div>
            <div class="scene-body">
              <h3>{item.titel}</h3>
              <p>{item.tekst}</p>
              <p class="scene-bron">
                <a class="brieflink" href={`/brief#${item.briefAnker}`}>
                  {item.briefLink}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"/></svg>
                </a>
              </p>
              {item.id === 'studenten' && <a class="text-link" href="#studentenschrift">Probeer mijn studentenschrift <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6" /></svg></a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="research" aria-labelledby="onderzoek-kop">
    <div class="container research-inner">
      <div class="research-copy"><h2 id="onderzoek-kop">{onderzoek.titel}</h2><p>{onderzoek.tekst}</p></div>
      <div class="bookshelf"><p class="book-statement">{onderzoek.citaat}</p><p class="book-context">{onderzoek.toelichting}</p></div>
    </div>
  </section>

  <StudentNotebook />

  <section class="contact band" id="contact" aria-labelledby="contact-kop">
    <div class="container contact-inner">
      <div><h2 id="contact-kop">{contact.titel}</h2><p>{contact.tekst}</p></div>
      <div class="contact-links">
        <a class="primary-link" href={`mailto:${contact.email}`}>{contact.knop} <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></a>
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
        <a href={`tel:${contact.telefoonHref}`}>{contact.telefoon}</a>
        <a class="text-link" href="/brief">Lees de volledige brief <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></a>
        {(briefBeschikbaar || cvBeschikbaar) && (
          <div class="downloads">
            <p class="downloads-label">{documenten.titel}</p>
            {briefBeschikbaar && <a href={briefBestand} download>{documenten.brief}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v12m-5-5 5 5 5-5M5 20h14"/></svg></a>}
            {cvBeschikbaar && <a href={cvBestand} download>{documenten.cv}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v12m-5-5 5 5 5-5M5 20h14"/></svg></a>}
          </div>
        )}
      </div>
    </div>
  </section>
  <script>
    import '../scripts/motion.js';
  </script>
</Base>
